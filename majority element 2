class Solution:
    def majorityElement(self, nums: List[int]) -> List[int]:
        if not nums:
            return []
        cnt1=cnt2=0
        val1=val2=None
        for num in nums:
            if num==val1:
                cnt1+=1
            elif num==val2:
                cnt2+=1
            elif cnt1==0:
                val1=num
                cnt1=1
            elif cnt2==0:
                val2=num
                cnt2=1
            else:
                cnt1-=1
                cnt2-=1
        arr=[]
        if nums.count(val1)>(len(nums)//3):
            arr.append(val1)
        if nums.count(val2)>(len(nums)//3):
            arr.append(val2)
        return arr
