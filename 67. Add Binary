class Solution:
    def addBinary(self, a: str, b: str) -> str:
        # Use a deque for efficient appends to the beginning
        from collections import deque
        res = deque()
        carry = 0
        i, j = len(a) - 1, len(b) - 1
        
        while i >= 0 or j >= 0 or carry:
            # Inline the calculation for clarity
            sum_val = carry
            if i >= 0:
                sum_val += int(a[i])
                i -= 1
            if j >= 0:
                sum_val += int(b[j])
                j -= 1
            
            # Append to the left (beginning) of the deque
            res.appendleft(str(sum_val % 2))
            carry = sum_val // 2
            
        # Join the deque directly
        return "".join(res)
