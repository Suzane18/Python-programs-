class Solution:
    def multiply(self, num1: str, num2: str) -> str:
        #return str(int(num1)*int(num2))
        if num1=="0" or num2=="0":
            return "0"
        def st(num):
            res = 0
            for i in range(len(num)):
                res = res * 10 + ord(num[i]) - ord('0')
            return res
        def ts(s):
            res=''
            while s:
                a=s%10
                s=s//10
                res=chr(a+ord('0'))+res
            return res
        return ts(st(num1) * st(num2))
